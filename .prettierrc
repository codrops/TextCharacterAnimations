{
	"printWidth": 120,
	"tabWidth": 4,
	"useTabs": false,
	"singleQuote": true,
	"quoteProps": "consistent",
	"bracketSpacing": false,
	"arrowParens": "avoid",
	"trailingComma": "all",
	"overrides": [
		{
			"files": ["*.css", "*.html"],
			"options": {"useTabs": true}
		},
		{
			"files": "*.html",
			"options": {"printWidth": 200}
		}
	]
}
